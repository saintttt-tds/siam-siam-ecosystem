{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*",
    "**/.env.*.local",
    "tsconfig.json",
    "config/.env.dev",
    "config/.env.staging",
    "config/.env.prod"
  ],
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "DB_HOST",
    "DB_PORT",
    "DB_NAME",
    "DB_USER",
    "DB_PASSWORD",
    "REDIS_HOST",
    "REDIS_PORT",
    "RABBITMQ_URL",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "ENCRYPTION_KEY",
    "API_GATEWAY_PORT",
    "AUTH_SERVICE_PORT",
    "PAYMENT_SERVICE_PORT",
    "COMMERCE_SERVICE_PORT",
    "DELIVERY_SERVICE_PORT",
    "NOTIFICATION_SERVICE_PORT",
    "USSD_SERVICE_PORT",
    "CORPORATE_FX_SERVICE_PORT",
    "AI_SERVICE_PORT"
  ],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"],
      "env": ["NODE_ENV"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "inputs": ["src/**/*.test.*", "tests/**/*", "jest.config.js"]
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "outputs": [],
      "inputs": ["src/**/*.js", ".eslintrc.js"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "db:migrate:rollback": {
      "cache": false
    },
    "db:seed": {
      "cache": false,
      "dependsOn": ["db:migrate"]
    },
    "deploy": {
      "cache": false,
      "dependsOn": ["build", "test", "lint"]
    }
  }
}