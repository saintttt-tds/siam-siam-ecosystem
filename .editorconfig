# .editorconfig
# SiamSiam Ecosystem - Editor Configuration
# Ensures consistent coding styles across different editors and IDEs

root = true

[*]
# Basic settings
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# JSON files
[*.json]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# Python files
[*.py]
indent_size = 4

# SQL files
[*.sql]
indent_size = 2

# Makefile
[Makefile]
indent_style = tab

# Terraform files
[*.tf]
indent_size = 2

# Docker files
[Dockerfile*]
indent_size = 4

# Shell scripts
[*.sh]
indent_size = 2

# XML/HTML files
[*.{xml,html,xhtml}]
indent_size = 2