{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "noEmit": false,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@siamsiam/shared-config": ["../shared-config"],
      "@siamsiam/shared-utils": ["../shared-utils"],
      "@siamsiam/shared-middleware": ["../shared-middleware"],
      "@siamsiam/shared-models": ["../shared-models"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "build", "coverage", "tests"]
}